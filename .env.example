# =================================================================
# 赣丰玻纤 · 数据飞轮系统 - 环境变量示例（Zeabur Variables 标签下添加）
# 复制本文件内容到 Zeabur 控制台，不要 commit .env 到 git
# =================================================================

# Flask 配置
TZ=Asia/Shanghai
FLASK_ENV=production
PORT=8080  # Zeabur 会自动覆盖

# DeepSeek AI 配置（智能客服 + 选品推荐理由）
# 在 Zeabur Variables 中设置真实的 API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 飞书同步（V7 后端）
LARK_DRY_RUN=true
LARK_APP_ID=cli_aa9db51beab89bc3
LARK_APP_SECRET=请到飞书开发者后台获取
LARK_BASE_TOKEN=your_lark_base_token_here

# 数据源（生产环境替换真实 key）
COMTRADE_API_KEY=
