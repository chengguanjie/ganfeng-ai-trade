# ============================================================
# 赣丰玻纤 AI 外贸系统 · 环境变量
# ============================================================
# 用法：复制为 .env 后填写；生产环境请直接在 Zeabur 控制台
#       「Variables」里配置，不要把真实密钥提交到 Git。
#
# 【必填】= 不配就用不了对应功能
# 【选填】= 不配会自动降级，系统照常运行
# ============================================================


# ------------------------------------------------------------
# 1. 数据库  【选填，但生产强烈建议配】
# ------------------------------------------------------------
# 不配 → 自动用本地 SQLite（data/trade.db）。
#        注意：Zeabur 容器重启会清空文件，生产必须配 Postgres。
# 配了 → 用 PostgreSQL。
#
# Zeabur 内网地址（部署在同一项目内时用这个，免公网流量、更快）：
#   DATABASE_URL=postgresql://用户名:密码@business-postgresql.zeabur.internal:5432/ganfeng_trade
# 本地连线上库调试时用公网地址：
#   DATABASE_URL=postgresql://用户名:密码@47.97.180.218:31191/ganfeng_trade
DATABASE_URL=

# 启动时是否写入 3 条演示客户/询盘（首次部署建议 true，之后可设 false）
SEED_SAMPLES=true


# ------------------------------------------------------------
# 2. DeepSeek 大模型  【必填，AI 客服和 AI 选品理由依赖它】
# ------------------------------------------------------------
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-你的DeepSeekKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat


# ------------------------------------------------------------
# 3. 飞书（Lark）  【必填，飞书打通依赖它】
# ------------------------------------------------------------
# 第一步：创建自建应用
#   https://open.feishu.cn/app  →  创建企业自建应用
#   创建后在「凭证与基础信息」页复制以下两项
LARK_APP_ID=cli_你的AppID
LARK_APP_SECRET=你的AppSecret

# 第二步：开通权限（开发者后台 →「权限管理」，勾选后必须「创建版本并发布」才生效）
#   bitable:app                读写多维表格          ← 写产品/客户/询盘/选品表必需
#   im:message:send_as_bot     以应用身份发送消息    ← 新询盘群通知必需
#   im:chat:readonly           获取群列表            ← 用 /api/feishu/chats 查 chat_id 用
#
# 第三步：多维表格 app_token
#   在飞书里新建一个多维表格 → 复制浏览器地址栏里的 token
#   形如 https://xxx.feishu.cn/base/BasabcDEFghij123  →  取 BasabcDEFghij123
#   还要在该表格右上角「...」→「更多」→「添加文档应用」把上面的自建应用加为协作者，
#   否则会报 permission denied。
LARK_BASE_TOKEN=Bas你的多维表格Token

# 第四步：接收通知的群 chat_id
#   把机器人拉进群后，调用 GET /api/feishu/chats 就能看到所有群及其 chat_id
#   不填 → 不推送群消息，但多维表格照常写入
LARK_CHAT_ID=oc_你的群ChatID

# 国际版 Lark 用 https://open.larksuite.com，国内飞书用默认值
LARK_DOMAIN=https://open.feishu.cn

# true = 演练模式，只打日志不真的调飞书接口（本地调试用）
LARK_DRY_RUN=false


# ------------------------------------------------------------
# 4. 免费数据源  【全部选填，不配也能跑】
# ------------------------------------------------------------
# UN Comtrade：公开预览接口无需 Key，但有速率限制。
#   如在 https://comtradeplus.un.org 申请了免费订阅 Key，填在这里可提高配额。
COMTRADE_API_KEY=

# 各数据源请求间隔（秒）。Comtrade 限流较严，调小容易 429。
COMTRADE_THROTTLE=1.5
WITS_THROTTLE=1.0
DATA_HTTP_TIMEOUT=30

# 选品结果缓存时长（秒），默认 6 小时
SOURCING_TTL=21600


# ------------------------------------------------------------
# 5. 运行时  【选填】
# ------------------------------------------------------------
PORT=5000
LOG_LEVEL=INFO
